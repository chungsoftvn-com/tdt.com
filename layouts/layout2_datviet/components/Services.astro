---
/**
 * Services (theme layout2 — "DatViet")
 * 4 thẻ DỊCH VỤ có ẢNH.
 *
 * Ảnh lấy từ `home.json` (`service_ticket_image`, `service_car_image`,
 * `service_team_image`, `service_custom_image`) để MỖI thẻ đúng với mô tả của nó
 * (máy bay / xe / teambuilding / tour riêng) — admin sửa được ở /admin/pages.
 * Thẻ nào chưa đặt ảnh thì lùi về ảnh tự động như trước (bìa tin gần đây + bìa tour).
 */
import { getContent, getNews, getTours, href } from '@/lib/content.js';
import Icon from './Icon.astro';

interface Props {
  lang: string;
}

const { lang } = Astro.props;
const t = getContent(lang, 'home');

const imgOf = (name?: string) =>
  !name
    ? '/content/vi/images/placeholder-tour.svg'
    : /^(https?:|\/)/.test(name)
      ? name
      : `/content/vi/images/${name}`;

/** Dự phòng khi thẻ dịch vụ chưa được đặt ảnh riêng. */
const photoPool = [
  ...getNews(lang)
    .filter((n) => n && n.image)
    .slice(3, 7)
    .map((n) => n.image),
  ...getTours(lang)
    .filter((x) => x && x.image)
    .slice(0, 4)
    .map((x) => x.image),
];

const services = (Array.isArray(t.service_cards) ? t.service_cards : []).map((s) => ({
  ...s, url: s.query ? `${href(lang, 'tim-tour')}?region=${s.query}` : href(lang, s.path),
}));
---

<section class="bg-white px-5 py-12">
  <div class="mx-auto max-w-6xl">
    <div class="dv-head">
      <h2>{t.services_title}</h2>
    </div>
    <div class="grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-4">
      {
        services.map((s, i) => (
          <article class="dv-svc" data-reveal style={`--reveal-delay:${i * 0.06}s`}>
            <img src={imgOf(s.image || photoPool[i])} alt={s.title} loading="lazy" decoding="async" />
            <div class="dv-svc-body">
              <span class="dv-svc-icon">
                <Icon name={s.icon} class="h-5 w-5" />
              </span>
              <h3><a href={s.url} class="hover:underline focus-visible:underline">{s.title}</a></h3>
              <p>{s.text}</p>
              <a href={s.url} class="mt-3 inline-flex min-h-11 items-center font-semibold text-sea-deep underline underline-offset-4" aria-label={`${lang === 'vi' ? 'Xem' : 'View'} ${s.title}`}>{lang === 'vi' ? 'Xem dịch vụ →' : 'View service →'}</a>
            </div>
          </article>
        ))
      }
    </div>
  </div>
</section>
