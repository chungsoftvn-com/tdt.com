---
/**
 * Services (theme layout2 — "DatViet")
 * 4 thẻ DỊCH VỤ có ẢNH (khối chữ trước đây bị khách chê "toàn chữ").
 * Ảnh lấy từ bìa các bài tin gần đây (ảnh thật của các chuyến đi) — tự sinh,
 * không cần admin nhập thêm; thiếu ảnh thì rơi về ảnh tour rồi placeholder.
 */
import { getContent, getNews, getTours } from '@/lib/content.js';
import Icon from './Icon.astro';

interface Props {
  lang: string;
}

const { lang } = Astro.props;
const t = getContent(lang, 'home');

const imgOf = (name?: string) =>
  !name
    ? '/content/vi/images/placeholder-tour.svg'
    : /^(https?:|\/)/.test(name)
      ? name
      : `/content/vi/images/${name}`;

const photoPool = [
  ...getNews(lang)
    .filter((n) => n && n.image)
    .slice(3, 7)
    .map((n) => n.image),
  ...getTours(lang)
    .filter((x) => x && x.image)
    .slice(0, 4)
    .map((x) => x.image),
];

const services = [
  { icon: 'plane', title: t.service_ticket_title, text: t.service_ticket_text },
  { icon: 'car', title: t.service_car_title, text: t.service_car_text },
  { icon: 'users', title: t.service_team_title, text: t.service_team_text },
  { icon: 'sparkles', title: t.service_custom_title, text: t.service_custom_text },
];
---

<section class="bg-white px-5 py-12">
  <div class="mx-auto max-w-6xl">
    <div class="dv-head">
      <h2>{t.services_title}</h2>
    </div>
    <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
      {
        services.map((s, i) => (
          <article class="dv-svc" data-reveal style={`--reveal-delay:${i * 0.06}s`}>
            <img src={imgOf(photoPool[i])} alt={s.title} loading="lazy" decoding="async" />
            <div class="dv-svc-body">
              <span class="dv-svc-icon">
                <Icon name={s.icon} class="h-5 w-5" />
              </span>
              <h3>{s.title}</h3>
              <p>{s.text}</p>
            </div>
          </article>
        ))
      }
    </div>
  </div>
</section>
