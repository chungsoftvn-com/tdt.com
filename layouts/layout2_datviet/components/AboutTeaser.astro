---
/**
 * AboutTeaser (theme layout2 — "DatViet")
 * Bên phải thay 4 ô ghi chú chữ bằng COLLAGE 3 ẢNH thật (ảnh các chuyến đi),
 * phần chữ giữ ngắn — trang chủ bớt chữ, nhiều hình hơn.
 */
import { getContent, getNews, getTours, href } from '@/lib/content.js';
import Icon from './Icon.astro';

interface Props {
  lang: string;
}

const { lang } = Astro.props;
const t = getContent(lang, 'home');

const imgOf = (name?: string) =>
  !name
    ? '/content/vi/images/placeholder-tour.svg'
    : /^(https?:|\/)/.test(name)
      ? name
      : `/content/vi/images/${name}`;

const photos = [
  ...getNews(lang)
    .filter((n) => n && n.image)
    .slice(7, 10)
    .map((n) => n.image),
  ...getTours(lang)
    .filter((x) => x && x.image)
    .slice(0, 3)
    .map((x) => x.image),
];

const points = [t.value_1_title, t.value_2_title, t.value_3_title, t.value_4_title].filter(Boolean);
---

<section class="bg-white px-5 py-12">
  <div class="mx-auto grid max-w-6xl items-center gap-8 lg:grid-cols-2">
    <div data-reveal>
      <p class="font-hand text-xl text-accent-deep sm:text-2xl">{t.about_teaser_kicker}</p>
      <h2 class="mt-1 font-display text-2xl leading-tight text-ink sm:text-3xl">
        {t.about_teaser_title}
      </h2>
      <p class="mt-3 leading-relaxed text-ink-soft">{t.about_teaser_text}</p>

      {points.length > 0 && (
        <ul class="mt-4 grid gap-1.5 sm:grid-cols-2">
          {points.map((p) => (
            <li class="flex items-start gap-2 text-sm font-medium text-ink">
              <Icon name="check" class="mt-0.5 h-4 w-4 flex-none text-sea" />
              {p}
            </li>
          ))}
        </ul>
      )}

      <a
        href={href(lang, 'about')}
        class="dv-btn dv-btn-outline mt-5"
      >
        {t.about_teaser_cta}
        <Icon name="arrow-right" class="h-4 w-4" />
      </a>
    </div>

    <div class="dv-collage" data-reveal>
      {
        photos.slice(0, 3).map((p, i) => (
          <img
            src={imgOf(p)}
            alt={t.about_teaser_title || ''}
            loading={i === 0 ? 'eager' : 'lazy'}
            decoding="async"
          />
        ))
      }
    </div>
  </div>
</section>
