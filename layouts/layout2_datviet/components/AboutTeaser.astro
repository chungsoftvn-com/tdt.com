---
/**
 * AboutTeaser (theme layout2 — "DatViet")
 * Giới thiệu ngắn cùng dải ba ảnh hành trình nằm ngang.
 */
import { getContent, href } from '@/lib/content.js';
import Icon from './Icon.astro';

interface Props {
  lang: string;
}

const { lang } = Astro.props;
const t = getContent(lang, 'home');

const imgOf = (name?: string) =>
  !name
    ? '/content/vi/images/placeholder-tour.svg'
    : /^(https?:|\/)/.test(name)
      ? name
      : `/content/vi/images/${name}`;

const photos = (Array.isArray(t.hero_slides) ? t.hero_slides : []).slice(0, 3);


const points = [t.value_1_title, t.value_2_title, t.value_3_title, t.value_4_title].filter(Boolean);
---

<section class="dv-home-about bg-white px-5 py-6">
  <div class="mx-auto grid max-w-6xl items-center gap-5 lg:grid-cols-[1.1fr_1fr]">
    <div data-reveal>
      <p class="text-sm font-bold uppercase tracking-wide text-accent-deep">{t.about_teaser_kicker}</p>
      <h2 class="mt-1 font-display text-2xl leading-tight text-ink">
        {t.about_teaser_title}
      </h2>
      <p class="mt-2 text-sm leading-relaxed text-ink-soft">{t.about_teaser_text}</p>

      {points.length > 0 && (
        <ul class="mt-3 grid gap-1 sm:grid-cols-2">
          {points.map((p) => (
            <li class="flex items-start gap-2 text-sm font-medium text-ink">
              <Icon name="check" class="mt-0.5 h-4 w-4 flex-none text-sea" />
              {p}
            </li>
          ))}
        </ul>
      )}

      <a
        href={href(lang, 'about')}
        class="dv-btn dv-btn-outline mt-3"
      >
        {t.about_teaser_cta}
        <Icon name="arrow-right" class="h-4 w-4" />
      </a>
    </div>

    <div class="dv-about-photos" data-reveal>
      {
        photos.slice(0, 3).map((p, i) => (
          <img
            src={imgOf(p.image)}
            alt={p.alt || t.about_teaser_title || ''}
            loading="lazy"
            decoding="async"
          />
        ))
      }
    </div>
  </div>
</section>
