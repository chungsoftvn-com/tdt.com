---
import { getContent, getTourRegions, getTours, href } from '@/lib/content.js';
import BaseLayout from './BaseLayout.astro';
import PageHero from './PageHero.astro';
import ToursGrid from './ToursGrid.astro';

interface Props {
  lang: string;
}

const { lang } = Astro.props;
const t = getContent(lang, 'tours');
const c = getContent(lang, 'common');
const tours = getTours(lang);
const domestic = tours.filter((x) => x.region === 'domestic');
const international = tours.filter((x) => x.region === 'international');

// KHU VỰC = các trang thật '/<lang>/tours/khu-vuc/<slug>/' (khác bộ lọc client-side
// bên dưới chỉ lọc trong trang này). Slug lấy từ region_name bản VI — xem
// `getTourRegions()` trong lib/content.js.
const regions = getTourRegions().map((r) => ({
  ...r,
  count: tours.filter((x) => r.tourSlugs.includes(x.slug)).length,
  types: [...new Set(tours.filter((x) => r.tourSlugs.includes(x.slug)).map((x) => x.region))].join(' '),
}));

const filters = [
  { key: 'all', label: c.region_all, list: tours },
  { key: 'domestic', label: c.region_domestic, list: domestic },
  { key: 'international', label: c.region_international, list: international },
];
---

<BaseLayout lang={lang} title={t.list_title}>
  <PageHero kicker={t.list_title} title={t.list_title} text={t.list_text} />

  <section class="px-5 py-14 sm:py-16">
    <div class="mx-auto max-w-6xl">
      <!-- Danh sách theo KHU VỰC (link sang trang riêng, có URL để SEO) -->
      <nav class="mb-8 flex flex-wrap justify-center gap-2" aria-label={t.list_title}>
        {
          regions.map((r) => (
            <a
              href={href(lang, `tours/khu-vuc/${r.slug}`)}
              data-tour-types={r.types}
              class="inline-flex min-h-10 items-center rounded-full border border-ink/15 bg-paper px-4 py-2 text-sm font-medium text-ink transition-colors hover:border-sea hover:text-sea"
            >
              {r.name}
              <span class="ml-1.5 rounded-full bg-ink/10 px-2 py-0.5 text-xs tabular-nums">
                {r.count}
              </span>
            </a>
          ))
        }
      </nav>

      <!-- Region filter -->
      <div data-tour-filters class="mb-10 flex flex-wrap justify-center gap-2" role="tablist" aria-label={t.list_title}>
        {
          filters.map((f, i) => (
            <button
              type="button"
              role="tab"
              data-filter={f.key}
              aria-selected={i === 0}
              class={`filter-chip ${i === 0 ? 'is-active' : ''}`}
            >
              {f.label}
              <span class="ml-1.5 rounded-full bg-ink/10 px-2 py-0.5 text-xs tabular-nums">{f.list.length}</span>
            </button>
          ))
        }
      </div>

      <div data-tour-grids>
        {
          filters.map((f) => (
            <div data-region={f.key} class={f.key === 'all' ? '' : 'hidden'}>
              <ToursGrid lang={lang} tours={f.list} />
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <script>
    const btns = document.querySelectorAll<HTMLButtonElement>('[data-tour-filters] [data-filter]');
    const grids = document.querySelectorAll<HTMLElement>('[data-tour-grids] [data-region]');
    const allowed = new Set(['all', 'domestic', 'international']);

    function applyFilter(key: string) {
      const selected = allowed.has(key) ? key : 'all';
      btns.forEach((btn) => {
        const active = btn.dataset.filter === selected;
        btn.classList.toggle('is-active', active);
        btn.setAttribute('aria-selected', String(active));
      });
      grids.forEach((grid) => grid.classList.toggle('hidden', grid.dataset.region !== selected));
      document.querySelectorAll<HTMLElement>('[data-tour-types]').forEach((link) => {
        link.classList.toggle('hidden', selected !== 'all' && !link.dataset.tourTypes?.split(' ').includes(selected));
      });
      document.querySelectorAll<HTMLAnchorElement>('header a[href*="?region="]').forEach((link) => {
        const active = new URL(link.href).searchParams.get('region') === selected;
        if (active) link.setAttribute('aria-current', 'page');
        else link.removeAttribute('aria-current');
        link.closest<HTMLElement>('[data-active]')?.setAttribute('data-active', String(active));
      });
    }

    function filterFromUrl() {
      applyFilter(new URL(window.location.href).searchParams.get('region') || 'all');
    }

    btns.forEach((btn) => {
      btn.addEventListener('click', () => {
        const key = btn.dataset.filter || 'all';
        const url = new URL(window.location.href);
        if (key === 'all') url.searchParams.delete('region');
        else url.searchParams.set('region', key);
        window.history.pushState(null, '', url);
        applyFilter(key);
      });
    });
    window.addEventListener('popstate', filterFromUrl);
    filterFromUrl();
  </script>
</BaseLayout>
