---
import { getContent, href } from '@/lib/content.js';
import Icon from './Icon.astro';

interface Props {
  lang: string;
}

const { lang } = Astro.props;
const t = getContent(lang, 'home');
const c = getContent(lang, 'common');
---

<section class="px-5 py-8 sm:py-10">
  <div
    data-reveal
    class="relative mx-auto max-w-6xl overflow-hidden rounded-3xl dv-planning-band px-5 py-7 text-center sm:px-12"
  >
    <div class="pointer-events-none absolute inset-0" aria-hidden="true">
      <div class="absolute -right-16 -top-16 h-56 w-56 rounded-full bg-sea-pale/20 blur-3xl" />
      <div class="absolute -bottom-20 -left-16 h-56 w-56 rounded-full dv-planning-glow blur-3xl" />
    </div>
    <div class="relative">
      <p class="text-xs font-bold tracking-widest dv-planning-kicker">{t.cta_kicker}</p>
      <h2 class="mt-1 font-display text-2xl leading-tight dv-planning-title sm:text-3xl">{t.cta_title}</h2>
      <p class="mx-auto mt-3 max-w-4xl dv-planning-text">{t.cta_text}</p>
      <div class="mt-5 flex flex-wrap items-center justify-center gap-3">
        <a
          href="https://zalo.me/0902898726" target="_blank" rel="noopener noreferrer"
          class="inline-flex min-h-11 items-center gap-2 rounded-full dv-planning-zalo px-5 py-2.5 text-sm font-semibold text-white shadow-[3px_3px_0_rgba(0,0,0,.2)] transition-transform duration-200 hover:scale-[1.03] active:scale-[0.97]"
        >
          Zalo Today Tourist · 0902 898 726
          <Icon name="arrow-right" class="h-4 w-4" />
        </a>
        <a
          href="tel:0913787647"
          class="inline-flex min-h-11 items-center gap-2 rounded-full border dv-planning-hotline px-5 py-2.5 text-sm font-semibold transition-colors"
        >
          <Icon name="phone" class="h-4 w-4" />
          Gọi hotline 0913 787 647
        </a>
      </div>
    </div>
  </div>
</section>
