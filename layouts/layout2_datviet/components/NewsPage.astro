---
import { getContent, getNews } from '@/lib/content.js';
import BaseLayout from './BaseLayout.astro';
import PageHero from './PageHero.astro';
import NewsCard from './NewsCard.astro';

interface Props {
  lang: string;
  /** Trang hien tai (bat dau tu 1). */
  page?: number;
}

const NEWS_PER_PAGE = 24;

const { lang, page = 1 } = Astro.props;
const t = getContent(lang, 'news');
const all = getNews(lang);
const totalPages = Math.max(1, Math.ceil(all.length / NEWS_PER_PAGE));
const news = all.slice((page - 1) * NEWS_PER_PAGE, page * NEWS_PER_PAGE);
const pageUrl = (n) => (n <= 1 ? `/${lang}/tin-tuc/` : `/${lang}/tin-tuc/trang/${n}/`);
const nums = [...new Set([1, page - 2, page - 1, page, page + 1, page + 2, totalPages])]
  .filter((n) => n >= 1 && n <= totalPages)
  .sort((a, b) => a - b);
const pageTitle = page > 1 ? `${t.list_title} – Trang ${page}` : t.list_title;
---

<BaseLayout lang={lang} title={pageTitle}>
  <PageHero kicker={t.list_title} title={t.list_title} text={t.list_text} />

  <section class="px-5 py-14 sm:py-16">
    <div class="mx-auto max-w-6xl">
      {
        news.length > 0 ? (
          <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
            {news.map((n) => <NewsCard lang={lang} item={n} />)}
          </div>
        ) : (
          <p class="py-20 text-center text-ink-soft">{t.list_empty}</p>
        )
      }
      {
        totalPages > 1 && (
          <nav aria-label="Phân trang" class="mt-12 flex flex-wrap items-center justify-center gap-2">
            {page > 1 && (
              <a href={pageUrl(page - 1)} rel="prev" class="rounded-lg border border-black/10 px-4 py-2 text-sm hover:bg-black/5">
                ← Trước
              </a>
            )}
            {nums.map((n, i) => (
              <>
                {i > 0 && n - nums[i - 1] > 1 && <span class="px-1 text-ink-soft">…</span>}
                <a
                  href={pageUrl(n)}
                  aria-current={n === page ? 'page' : undefined}
                  class={`min-w-10 rounded-lg border px-3 py-2 text-center text-sm ${n === page ? 'border-transparent bg-black text-white' : 'border-black/10 hover:bg-black/5'}`}
                >
                  {n}
                </a>
              </>
            ))}
            {page < totalPages && (
              <a href={pageUrl(page + 1)} rel="next" class="rounded-lg border border-black/10 px-4 py-2 text-sm hover:bg-black/5">
                Sau →
              </a>
            )}
          </nav>
        )
      }
    </div>
  </section>
</BaseLayout>
