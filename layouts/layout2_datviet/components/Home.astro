---
/**
 * Home (theme layout2 — "DatViet")
 *  · Hero banner + khối tìm tour 2 tab (Trong nước / Nước ngoài) + chip khu vực.
 *  · Vẫn tôn trọng `home_blocks` của admin (hero/about/services/stats/hot/values/
 *    partners/cta/custom) như layout1 — chỉ khác cách trình bày.
 *  · Thêm các mục đặc trưng: tour theo từng khu vực, logo đối tác, tin tức.
 */
import {
  getContent,
  getNews,
  getTours,
  href,
  slugifyVi,
} from '@/lib/content.js';
import { richDoc } from '@/lib/rich.js';
import { DEFAULT_HOME_BLOCKS, customBodyKey } from '@/lib/homeblocks.js';
import BaseLayout from './BaseLayout.astro';
import AboutTeaser from './AboutTeaser.astro';
import Services from './Services.astro';
import Stats from './Stats.astro';
import Values from './Values.astro';
import CTABand from './CTABand.astro';
import PartnersSlider from './PartnersSlider.astro';
import TourCard from './TourCard.astro';
import NewsCard from './NewsCard.astro';
import Icon from './Icon.astro';

interface Props {
  lang: string;
}

const { lang } = Astro.props;
const t = getContent(lang, 'home');
const c = getContent(lang, 'common');
const tours = getTours(lang);
const allNews = getNews(lang);
const news = allNews.slice(0, 3);

/** Ảnh dùng cho các khối hình (mosaic/collage/dải ảnh): bìa các bài tin gần đây. */
const imgOf = (name?: string) =>
  !name
    ? '/content/vi/images/placeholder-tour.svg'
    : /^(https?:|\/)/.test(name)
      ? name
      : `/content/vi/images/${name}`;
const newsWithImage = allNews.filter((n) => n && n.image);
/** Bỏ 3 bài đã hiện ở khối tin tức để ảnh không trùng nhau trong trang. */
const galleryItems = newsWithImage.slice(3, 7);

const hotSlugs = Array.isArray(t.hot_tours) ? t.hot_tours : [];
const hotTours = hotSlugs.length
  ? tours.filter((x) => hotSlugs.includes(x.slug))
  : tours.slice(0, 12);
/** Mosaic "Điểm đến nổi bật" = 4 tour đầu trong danh sách hot (admin chọn ở home.json). */
const featuredTours = hotTours.length ? hotTours : tours.slice(0, 8);
/** Lưới "Tour hot" bên dưới: các tour KHÁC mosaic (tránh lặp ảnh). */
const featuredSlugs = new Set(featuredTours.map((x) => x.slug));
const gridTours = tours.filter((x) => !featuredSlugs.has(x.slug)).slice(0, 8);
const read = (k) => (typeof t[k] === 'string' ? t[k] : '');

const blocks = (
  Array.isArray(t.home_blocks) && t.home_blocks.length ? t.home_blocks : DEFAULT_HOME_BLOCKS
).filter((b) => b && b.type && b.enabled !== false);

/**
 * Ưu tiên HÌNH ẢNH: khối "tour hot" luôn được kéo lên ngay sau hero để khách
 * thấy ảnh tour sớm (khách phản hồi trang chủ "toàn chữ").
 */
const orderedBlocks = (() => {
  const list = [...blocks];
  const heroIdx = list.findIndex((b) => b.type === 'hero');
  const hotIdx = list.findIndex((b) => b.type === 'hot');
  if (heroIdx !== -1 && hotIdx > heroIdx + 1) {
    const [hot] = list.splice(hotIdx, 1);
    list.splice(heroIdx + 1, 0, hot);
  }
  return list;
})();

/** Nhóm tour theo khu vực trong 1 nhóm (domestic | international). */
const regionGroups = (type: string) => {
  const map = new Map<string, { name: string; slug: string; items: typeof tours }>();
  for (const tour of tours) {
    if (tour.region !== type) continue;
    const name = String(tour.regionName || '').trim();
    if (!name) continue;
    if (!map.has(name)) map.set(name, { name, slug: slugifyVi(name), items: [] });
    map.get(name)!.items.push(tour);
  }
  return [...map.values()].sort((a, b) => a.name.localeCompare(b.name, 'vi'));
};

const domesticGroups = regionGroups('domestic');
const intlGroups = regionGroups('international');

const chipLinks = [...domesticGroups, ...intlGroups].map((g) => ({
  label: g.name,
  url: href(lang, `tours/khu-vuc/${g.slug}`),
}));

const heroSlides = (Array.isArray(t.hero_slides) ? t.hero_slides : [])
  .filter((slide) => slide && typeof slide.image === 'string' && slide.image)
  .slice(0, 20);
const showHeroSlideshow = heroSlides.length >= 10;
const searchPlaceholder = c.home_search_placeholder;

/** Dữ liệu lấy từ Facebook Page (content/vi/facebook.json) — bản EN chưa có thì dùng VI. */
const readFb = (l: string): any => {
  try {
    return getContent(l, 'facebook') ?? {};
  } catch {
    return {};
  }
};
const fb = (() => {
  const own = readFb(lang);
  return own && own.page_url ? own : readFb('vi');
})();
const fbPhotos: any[] = Array.isArray(fb.photos) ? fb.photos : [];
---

<BaseLayout lang={lang}>
  {
    orderedBlocks.map((b) => {
      switch (b.type) {
        case 'hero':
          return (
            <>
            <section class="dv-hero-photo dv-brand-hero overflow-hidden bg-sea-pale text-ink">
              <div class:list={["dv-hero-layout mx-auto max-w-6xl px-5 py-8 sm:py-12", { "dv-hero-text-only": !showHeroSlideshow }]}>
                <div class="dv-hero-copy">
                  <h1 class="font-display text-3xl font-bold leading-tight text-sea-deep sm:text-4xl">{t.hero_title}</h1>
                  <p class="mt-4 leading-relaxed text-ink-soft">{t.hero_text}</p>
                  <div class="mt-5 flex flex-wrap gap-3">
                    <a href="tel:0913787647" class="dv-btn dv-btn-accent">Hotline: 0913 78 76 47</a>
                    <a href="https://zalo.me/0902898726" target="_blank" rel="noopener noreferrer" class="dv-btn dv-btn-outline">Zalo Today Tourist</a>
                  </div>
                </div>
                {showHeroSlideshow && (
                  <figure class="dv-hero-visual" data-hero-carousel role="region" aria-roledescription="trình chiếu" aria-label="Những hành trình cùng TodayTourist">
                    <div class="dv-hero-stage">
                      {heroSlides.map((slide, i) => (
                        <img data-hero-slide src={i === 0 ? imgOf(slide.image) : undefined} data-src={imgOf(slide.image)} alt={slide.alt || 'Hành trình cùng TodayTourist'} width="900" height="600" loading={i === 0 ? 'eager' : 'lazy'} decoding="async" hidden={i !== 0} />
                      ))}
                    </div>
                    <figcaption class="dv-hero-caption">
                      <span>Những hành trình cùng TodayTourist</span>
                      <div class="dv-hero-controls">
                        <button type="button" data-hero-prev aria-label="Ảnh trước">‹</button>
                        <span data-hero-count aria-live="off">1 / {heroSlides.length}</span>
                        <button type="button" data-hero-next aria-label="Ảnh tiếp theo">›</button>
                        <button type="button" data-hero-pause aria-label="Tạm dừng trình chiếu">Ⅱ</button>
                      </div>
                    </figcaption>
                  </figure>
                )}
              </div>

              {/* Khối tìm tour 2 tab */}
              <div class="mx-auto w-full max-w-6xl px-5">
                <div class="rounded-t-[var(--radius-card)] bg-white/95 p-3 shadow-[var(--shadow-lift-2)] sm:p-4">
                  <div class="flex gap-1">
                    <button type="button" class="dv-tab" data-tab="domestic" data-active="true">
                      {c.region_domestic}
                    </button>
                    <button type="button" class="dv-tab" data-tab="international" data-active="false">
                      {c.region_international}
                    </button>
                  </div>

                  <form
                    action={href(lang, 'tim-tour')}
                    method="get"
                    class="mt-3 grid gap-2 sm:grid-cols-[1fr_auto]"
                    role="search"
                  >
                    <input
                      type="search"
                      name="q"
                      class="dv-search-input !rounded-[var(--radius-btn)] !border-2"
                      placeholder={searchPlaceholder}
                      aria-label={searchPlaceholder}
                    />
                    <input type="hidden" name="region" value="domestic" data-region-input />
                    <button type="submit" class="dv-btn dv-btn-green">
                      <Icon name="search" class="h-4 w-4" />
                      {c.nav_find_tour}
                    </button>
                  </form>

                  <div class="mt-3 flex flex-wrap gap-2" data-chips="domestic">
                    {domesticGroups.map((g) => (
                      <a class="dv-chip" href={href(lang, `tours/khu-vuc/${g.slug}`)}>
                        <Icon name="arrow-right" class="h-3.5 w-3.5 text-sea" />
                        {g.name}
                      </a>
                    ))}
                  </div>
                  <div class="mt-3 hidden flex-wrap gap-2" data-chips="international">
                    {intlGroups.map((g) => (
                      <a class="dv-chip" href={href(lang, `tours/khu-vuc/${g.slug}`)}>
                        <Icon name="arrow-right" class="h-3.5 w-3.5 text-sea" />
                        {g.name}
                      </a>
                    ))}
                  </div>
                </div>
              </div>
            </section>

            {/* Điểm đến nổi bật: một hàng thẻ gọn, chú thích tách khỏi ảnh. */}
            {featuredTours.length > 0 && (
              <section class="bg-white px-5 py-6 sm:py-8">
                <div class="mx-auto max-w-6xl">
                  <div class="dv-head">
                    <h2>{t.featured_destinations_title}</h2>
                    <a href={href(lang, 'tours')}>{t.view_all_tours}</a>
                  </div>
                  <div class="dv-featured-row" role="region" aria-label="Điểm đến nổi bật" tabindex="0">
                    {featuredTours.slice(0, 4).map((tour, i) => (
                      <a
                        class="dv-featured-card"
                        href={href(lang, `tours/${tour.slug}`)}
                      >
                        <img
                          src={imgOf(tour.image)}
                          alt={tour.name}
                          loading={i === 0 ? 'eager' : 'lazy'}
                          decoding="async"
                        />
                        <span class="dv-featured-caption">
                          <strong>{tour.name}</strong>
                          {tour.duration && <em>{tour.duration}</em>}
                        </span>
                      </a>
                    ))}
                  </div>
                </div>
              </section>
            )}
            </>
          );
        case 'about':
          return <AboutTeaser lang={lang} />;
        case 'services':
          return <Services lang={lang} />;
        case 'stats':
          return <Stats lang={lang} />;
        case 'hot':
          return (
            <section class="bg-sand px-5 py-12 sm:py-14">
              <div class="mx-auto max-w-6xl">
                <div class="dv-head">
                  <h2>{t.hot_tours_title}</h2>
                  <a href={href(lang, 'tours')}>
                    {t.view_all_tours}
                  </a>
                </div>
                {t.hot_tours_text && <p class="dv-head-sub">{t.hot_tours_text}</p>}
                <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
                  {gridTours.map((tour, i) => (
                    <TourCard lang={lang} tour={tour} hot={i < 2} />
                  ))}
                </div>
              </div>
            </section>
          );
        case 'values':
          return <Values lang={lang} />;
        case 'partners':
          return <PartnersSlider lang={lang} />;
        case 'cta':
          return <CTABand lang={lang} />;
        case 'custom':
          return (
            <section class="px-5 py-12">
              <div class="rich-doc mx-auto max-w-4xl" set:html={richDoc(read(customBodyKey(b.id)))} />
            </section>
          );
        default:
          return null;
      }
    })
  }

  {/* Tour theo khu vực — mỗi khu vực 1 hàng thẻ + link xem thêm */}
  {
    [
      { title: c.region_domestic, groups: domesticGroups },
      { title: c.region_international, groups: intlGroups },
    ]
      .filter((sec) => sec.groups.length > 0)
      .map((sec) => (
        <section class="bg-white px-5 py-12">
          <div class="mx-auto max-w-6xl">
            {sec.groups.map((g) => (
              <div class="mb-10 last:mb-0">
                <div class="dv-head">
                  <h2>{g.name}</h2>
                  <a href={href(lang, `tours/khu-vuc/${g.slug}`)}>
                    {t.view_all_tours} ({g.items.length})
                  </a>
                </div>
                <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
                  {g.items.slice(0, 3).map((tour) => (
                    <TourCard lang={lang} tour={tour} />
                  ))}
                </div>
              </div>
            ))}
          </div>
        </section>
      ))
  }

  {/* Dải ảnh hành trình — ảnh thật từ các chuyến đi (lấy từ bài tin gần đây) */}
  {
    galleryItems.length >= 4 && (
      <section class="bg-sand px-5 py-12">
        <div class="mx-auto max-w-6xl">
          <div class="dv-head">
            <h2>{t.trip_moments_title}</h2>
            <a href={href(lang, 'tin-tuc')}>{c.nav_news}</a>
          </div>
          <div class="dv-moments-row">
            {galleryItems.slice(0, 4).map((n) => (
              <a class="dv-strip-item" href={href(lang, `tin-tuc/${n.slug}`)}>
                <img src={imgOf(n.image)} alt={n.title} loading="lazy" decoding="async" />
                <span class="dv-strip-cap">{n.title}</span>
              </a>
            ))}
          </div>
        </div>
      </section>
    )
  }

  {/* Tin tức & cẩm nang */}
  {
    news.length > 0 && (
      <section class="bg-white px-5 py-12">
        <div class="mx-auto max-w-6xl">
          <div class="dv-head">
            <h2>{c.nav_news}</h2>
            <a href={href(lang, 'tin-tuc')}>{t.view_all_tours}</a>
          </div>
          <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
            {news.map((item) => (
              <NewsCard lang={lang} item={item} />
            ))}
          </div>
        </div>
      </section>
    )
  }

  {/* Hình ảnh mới nhất từ Facebook Page */}
  {
    fbPhotos.length > 0 && (
      <section class="border-t border-black/5 bg-sea-pale/70 px-5 py-12">
        <div class="mx-auto max-w-6xl">
          <div class="dv-head">
            <h2>{t.facebook_section_title ?? fb.section_title ?? 'Facebook'}</h2>
            <a href={fb.page_url} target="_blank" rel="noopener noreferrer">
              {t.facebook_cta_label ?? fb.cta_label ?? 'Facebook'}
            </a>
          </div>
          {(t.facebook_section_text ?? fb.section_text) && (
            <p class="dv-head-sub">{t.facebook_section_text ?? fb.section_text}</p>
          )}
          <div class="grid grid-cols-2 gap-3 sm:grid-cols-3 lg:grid-cols-5">
            {fbPhotos.map((p) => (
              <a
                class="group overflow-hidden rounded-[var(--radius-card)] shadow-[var(--shadow-lift-1)]"
                href={p.url || fb.page_url}
                target="_blank"
                rel="noopener noreferrer"
              >
                <img
                  src={`/content/vi/images/${p.image}`}
                  alt={p.alt || fb.page_name}
                  loading="lazy"
                  decoding="async"
                  class="aspect-[4/3] w-full object-cover transition-transform duration-500 group-hover:scale-105"
                />
              </a>
            ))}
          </div>
          <div class="mt-6 flex flex-wrap items-center gap-4">
            <a
              class="dv-btn dv-btn-accent"
              href={fb.page_url}
              target="_blank"
              rel="noopener noreferrer"
            >
              {t.facebook_cta_label ?? fb.cta_label ?? 'Facebook'}
            </a>
            {(t.facebook_followers ?? fb.followers) && (
              <span class="text-sm text-ink-soft">
                <strong class="text-sea-deep">{t.facebook_followers ?? fb.followers}</strong>{' '}
                {t.facebook_followers_label ?? fb.followers_label}
              </span>
            )}
            {(t.facebook_bio ?? fb.bio) && (
              <span class="max-w-2xl text-sm leading-relaxed text-ink-soft">
                {t.facebook_bio ?? fb.bio}
              </span>
            )}
          </div>
        </div>
      </section>
    )
  }

  {/* Tư vấn & Kinh doanh (giữ như web cũ) */}
  {
    read('sales_title') && (
      <section class="border-t border-black/5 bg-sand-deep/60 px-5 py-12">
        <div class="mx-auto max-w-6xl text-center">
          <h2 class="font-display text-2xl text-ink">{c.sales_title}</h2>
          <div class="rich-doc mx-auto mt-4 max-w-2xl" set:html={richDoc(c.sales_body_html)} />
        </div>
      </section>
    )
  }
</BaseLayout>

<script>
  // Tab "Trong nước / Nước ngoài" trong khối tìm tour: đổi danh sách chip + giá
  // trị `region` gửi kèm khi submit.
  const tabs = document.querySelectorAll<HTMLButtonElement>('.dv-tab[data-tab]');
  const regionInput = document.querySelector<HTMLInputElement>('[data-region-input]');
  tabs.forEach((tab) => {
    tab.addEventListener('click', () => {
      const key = tab.dataset.tab || 'domestic';
      tabs.forEach((x) => x.setAttribute('data-active', String(x === tab)));
      document.querySelectorAll<HTMLElement>('[data-chips]').forEach((box) => {
        box.classList.toggle('hidden', box.dataset.chips !== key);
      });
      if (regionInput) regionInput.value = key;
    });
  });

  const carousel = document.querySelector<HTMLElement>('[data-hero-carousel]');
  if (carousel) {
    const slides = Array.from(carousel.querySelectorAll<HTMLImageElement>('[data-hero-slide]'));
    const counter = carousel.querySelector<HTMLElement>('[data-hero-count]');
    const pause = carousel.querySelector<HTMLButtonElement>('[data-hero-pause]');
    const motion = window.matchMedia('(prefers-reduced-motion: reduce)');
    let index = 0;
    let paused = motion.matches;
    let hovered = false;
    let focused = false;
    let changing = false;
    const loadImage = (image: HTMLImageElement) => {
      if (!image.getAttribute('src') && image.dataset.src) {
        image.loading = 'eager';
        image.src = image.dataset.src;
      }
    };
    const updatePause = () => {
      if (!pause) return;
      pause.textContent = paused ? '▶' : 'Ⅱ';
      pause.setAttribute('aria-label', paused ? 'Tiếp tục trình chiếu' : 'Tạm dừng trình chiếu');
    };
    const show = async (step: number) => {
      if (changing || slides.length < 2) return;
      changing = true;
      const next = (index + step + slides.length) % slides.length;
      loadImage(slides[next]);
      try {
        await slides[next].decode();
        slides[index].hidden = true;
        slides[next].hidden = false;
        index = next;
        if (counter) counter.textContent = String(index + 1) + ' / ' + slides.length;
        loadImage(slides[(index + 1) % slides.length]);
      } catch {
        // Leave the current photo visible if a request fails.
      } finally { changing = false; }
    };
    carousel.querySelector('[data-hero-prev]')?.addEventListener('click', () => void show(-1));
    carousel.querySelector('[data-hero-next]')?.addEventListener('click', () => void show(1));
    pause?.addEventListener('click', () => { paused = !paused; updatePause(); });
    carousel.addEventListener('mouseenter', () => { hovered = true; });
    carousel.addEventListener('mouseleave', () => { hovered = false; });
    carousel.addEventListener('focusin', () => { focused = true; });
    carousel.addEventListener('focusout', (event) => {
      focused = event.relatedTarget instanceof Node && carousel.contains(event.relatedTarget);
    });
    motion.addEventListener('change', () => { paused = motion.matches; updatePause(); });
    window.setInterval(() => {
      if (!paused && !hovered && !focused && !document.hidden) void show(1);
    }, 5000);
    updatePause();
    if (slides[1]) loadImage(slides[1]);
  }
</script>

<style>
  .dv-hero-layout.dv-hero-text-only { grid-template-columns: 1fr; }
  .dv-hero-stage { aspect-ratio: 3 / 2; overflow: hidden; }
  .dv-hero-stage img { width: 100%; height: 100%; object-fit: contain; }
  .dv-hero-stage img[hidden] { display: none; }
  .dv-hero-visual .dv-hero-caption { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: .5rem; }
  .dv-hero-controls { display: flex; align-items: center; gap: .45rem; }
  .dv-hero-controls button { display: inline-flex; align-items: center; justify-content: center; width: 2rem; height: 2rem; border: 1px solid #ffffff70; border-radius: .3rem; color: white; font-size: 1rem; cursor: pointer; }
  .dv-hero-controls button:hover { background: #ffffff20; }
  .dv-hero-controls button:focus-visible { outline: 2px solid white; outline-offset: 3px; }
  [data-hero-count] { min-width: 3.5rem; text-align: center; font-variant-numeric: tabular-nums; }

  .dv-featured-row { display: flex; gap: 1rem; overflow-x: auto; scroll-snap-type: x proximity; padding-bottom: .4rem; scrollbar-width: thin; }
  .dv-featured-card { display: flex; flex: 0 0 80%; min-width: 0; flex-direction: column; scroll-snap-align: start; overflow: hidden; border: 1px solid #00000014; border-radius: var(--radius-card); background: white; color: var(--color-ink); }
  .dv-featured-card img { display: block; width: 100%; aspect-ratio: 16 / 9; object-fit: contain; background: #f5f5f5; }
  .dv-featured-caption { display: flex; flex: 1; flex-direction: column; gap: .45rem; padding: .75rem; }
  .dv-featured-caption strong { font-size: .86rem; line-height: 1.5; overflow-wrap: anywhere; }
  .dv-featured-caption em { margin-top: auto; font-size: .8rem; font-style: normal; color: var(--color-ink-soft); }
  .dv-featured-card:hover strong { color: var(--color-sea-deep); }
  .dv-featured-row:focus-visible { outline: 2px solid var(--color-sea); outline-offset: 3px; }
  @media (min-width: 640px) { .dv-featured-card { flex-basis: 45%; } }
  @media (min-width: 1024px) { .dv-featured-card { flex-basis: calc((100% - 3rem) / 4); } }

  .dv-moments-row { display: flex; gap: .75rem; overflow-x: auto; scroll-snap-type: x proximity; padding-bottom: .3rem; }
  .dv-moments-row .dv-strip-item { flex: 0 0 80%; min-width: 0; aspect-ratio: 16 / 10; scroll-snap-align: start; }
  @media (min-width: 640px) { .dv-moments-row .dv-strip-item { flex-basis: 45%; } }
  @media (min-width: 1024px) { .dv-moments-row .dv-strip-item { flex-basis: calc((100% - 2.25rem) / 4); } }
</style>
