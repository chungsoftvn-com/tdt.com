---
/** Single footer: contact, services, information and official social links. */
import { getContent, href } from '@/lib/content.js';

interface Props {
  lang: string;
}

const { lang } = Astro.props;
const t = getContent(lang, 'common');
const tel = String(t.hotline || '').replace(/[^0-9+]/g, '');

const services = [
  { label: t.region_domestic, url: `${href(lang, 'tours')}?region=domestic` },
  { label: t.region_international, url: `${href(lang, 'tours')}?region=international` },
  { label: t.nav_find_tour, url: href(lang, 'tim-tour') },
  { label: t.nav_book, url: href(lang, 'dat-tour') },
  { label: t.nav_tickets, url: href(lang, 've-may-bay') },
  { label: t.nav_car, url: href(lang, 'cho-thue-xe') },
  { label: 'Team building', url: href(lang, 'to-chuc-team-building') },
  { label: 'Gala dinner', url: href(lang, 'to-chuc-gala-dinner') },
  { label: 'Tour học sinh', url: href(lang, 'tour-hoc-sinh') },
];

const infos = [
  { label: t.nav_about, url: href(lang, 'about') },
  { label: t.nav_news, url: href(lang, 'tin-tuc') },
  { label: t.nav_testimonials, url: href(lang, 'y-kien-khach-hang') },
  { label: t.nav_partners, url: href(lang, 'doi-tac') },
  { label: t.nav_recruit, url: href(lang, 'tuyen-dung') },
  { label: t.nav_directions, url: href(lang, 'chi-duong') },
  { label: t.nav_contact, url: href(lang, 'contact') },
];

const asUrl = (v: unknown) =>
  /^https?:\/\//i.test(String(v || '').trim()) ? String(v).trim() : '';
const socials = [
  {
    label: t.footer_facebook || 'Facebook',
    url:
      asUrl(t.social_facebook) ||
      asUrl(getContent('vi', 'facebook')?.page_url) ||
      'https://www.facebook.com/profile.php?id=61563008528761',
    color: '#1877f2',
  },
  { label: t.footer_tiktok || 'TikTok', url: asUrl(t.social_tiktok), color: '#111111' },
  {
    label: t.footer_zalo || 'Zalo',
    url: 'https://zalo.me/0902898726',
    color: '#0068ff',
  },
].filter((s) => s.url);


---

<footer class="dv-footer mt-10">
  <div class="dv-footer-contact mx-auto flex max-w-6xl flex-wrap items-center justify-between gap-4 px-5 py-5">
    <div><h2 class="text-base font-bold sm:text-lg">Chuyến đi đáng nhớ bắt đầu từ một cuộc trò chuyện</h2><p class="mt-2">Chia sẻ ngày đi, số khách và ngân sách — TodayTourist cùng bạn lên lịch trình.</p></div>
    <a href="https://zalo.me/0902898726" target="_blank" rel="noopener noreferrer" class="dv-btn dv-btn-outline">Zalo Today Tourist · 0902 898 726</a>
  </div>
  <div class="dv-footer-grid mx-auto grid max-w-6xl gap-6 px-5 py-6 sm:grid-cols-2 lg:grid-cols-4">
    <!-- Cột 1: thương hiệu + liên hệ -->
    <div>
      <div class="flex items-center gap-2.5">
        <img
          src="/content/vi/images/logo.webp"
          alt={t.brand_name}
          width="74"
          height="80"
          loading="lazy"
          decoding="async"
          class="h-12 w-auto"
        />
        <span class="leading-tight">
          <span class="block font-display text-base font-bold text-sea-deep">{t.brand_name}</span>
          <span class="block text-xs font-semibold uppercase tracking-[0.18em] text-ink-soft">
            {t.brand_tagline}
          </span>
        </span>
      </div>
      <p class="mt-3 leading-relaxed text-ink-soft">Đồng hành cùng gia đình, trường học và doanh nghiệp trong những hành trình trong nước, quốc tế và sự kiện theo yêu cầu.</p>
      <ul class="mt-3 grid gap-1.5">
        <li>
          <span class="font-semibold">{t.address_label}:</span>
          <span class="text-ink-soft">{t.address}</span>
        </li>
        <li>
          <a class="dv-btn dv-btn-accent dv-footer-hotline" href={`tel:${tel}`}>Hotline: 0913 787 647</a>
        </li>
        <li>
          <span class="font-semibold">{t.email_label}:</span>
          <a href={`mailto:${t.email}`}>{t.email}</a>
        </li>
      </ul>
    </div>

    <!-- Cột 2: dịch vụ -->
    <div>
      <h3>Dịch vụ du lịch</h3>
      <ul class="grid gap-1.5">
        {
          services.map((s) => (
            <li>
              <a href={s.url}>{s.label}</a>
            </li>
          ))
        }
      </ul>
    </div>

    <!-- Cột 3: thông tin -->
    <div>
      <h3>Về TodayTourist</h3>
      <ul class="grid gap-1.5">
        {
          infos.map((s) => (
            <li>
              <a href={s.url}>{s.label}</a>
            </li>
          ))
        }
      </ul>
    </div>

    <!-- Cột 4: nhận tin + social -->
    <div>
      <p class="mb-4 text-sm text-ink-soft">Nhắn Zalo để được tư vấn lịch trình và báo giá; theo dõi Facebook, TikTok để xem hành trình thực tế.</p>
      {
        socials.length > 0 && (
          <>
            <h3 class="mt-5">{t.footer_social_title}</h3>
            <div class="flex flex-wrap items-center gap-2">
              {socials.map((s) => (
                <a
                  href={s.url}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="inline-flex min-h-11 items-center justify-center rounded px-4 py-2 text-sm font-semibold text-white"
                  aria-label={`${s.label} của TodayTourist (mở tab mới)`}
                  style={`background:${s.color}`}
                >
                  {s.label}
                </a>
              ))}
            </div>
          </>
        )
      }

      {
        t.website && (
          <p class="mt-5 text-sm text-ink-soft">
            <span class="font-semibold">{t.website_label}:</span> {t.website}
          </p>
        )
      }
    </div>
  </div>

  <div class="dv-copyright">
    <div
      class="mx-auto flex max-w-6xl flex-col items-center justify-between gap-1 px-5 py-3 text-center sm:flex-row sm:text-left"
    >
      <p>© {new Date().getFullYear()} {t.brand_name}. {t.rights}</p>

    </div>
  </div>
</footer>


<style>  .dv-footer { background: #fff; color: var(--color-ink); font-size: .875rem; line-height: 1.6; border-top: 1px solid #e5e7eb; }
  .dv-footer .text-ink-soft { color: var(--color-ink-soft); }
  .dv-footer .text-sea-deep { color: var(--color-sea-deep); }
  .dv-footer h3 { color: var(--color-sea-deep); font-size: .875rem; margin-bottom: .6rem; }
  .dv-footer a:hover { color: var(--color-sea); }
  .dv-footer-contact { border-bottom: 1px solid #e5e7eb; }
  .dv-footer-contact .dv-btn { color: var(--color-sea-deep); }
  .dv-footer .dv-copyright { background: var(--color-sand); color: var(--color-ink-soft); font-size: .8rem; }
  .dv-footer li a { display: inline-block; padding-block: .1rem; }
  .dv-footer a.dv-footer-hotline { padding: .6rem 1rem; background: var(--color-accent); color: white; font-size: .875rem; }
  .dv-footer a.dv-footer-hotline:hover { color: white; }
  .dv-footer-contact .dv-btn:hover { color: white; }

  .dv-footer { border-top: 4px solid var(--color-gold); }
  .dv-footer-grid { padding-top: 2rem; padding-bottom: 2rem; gap: 2rem; }
  .dv-footer-grid > div { min-width: 0; }
  .dv-footer h3 { font-weight: 800; color: var(--color-accent); letter-spacing: .035em; padding-bottom: .55rem; border-bottom: 1px solid #d6dee7; margin-bottom: .85rem; }
  .dv-footer-grid li { line-height: 1.7; }
  .dv-footer-grid a { overflow-wrap: anywhere; }
  .dv-footer-grid li a:not(.dv-footer-hotline) { padding-block: .25rem; color: var(--color-ink); }
  .dv-footer-contact { background: var(--color-sea-pale); border-radius: 0 0 12px 12px; gap: 1rem; }
  .dv-footer-contact h2 { color: var(--color-sea-deep); line-height: 1.4; }
  .dv-footer-contact p { color: var(--color-ink); }
  .dv-footer-grid .text-ink-soft { color: #475569; }
  .dv-footer-grid a:focus-visible { outline: 3px solid var(--color-sea-soft); outline-offset: 3px; }
  @media (max-width: 639px) {
    .dv-footer-grid { gap: 1.5rem; padding-right: 4.5rem; }
    .dv-footer-grid > div + div { padding-top: 1rem; border-top: 1px solid #e2e8f0; }
    .dv-footer-contact { margin-inline: .75rem; padding-inline: 1rem; }
    .dv-footer-contact .dv-btn { width: 100%; white-space: normal; text-align: center; }
  }


</style>
