---
/**
 * AboutTeaser — bên phải thay 4 ô ghi chú chữ bằng COLLAGE 3 ẢNH thật; phần chữ
 * rút gọn còn 4 dòng check. (Trang chủ bớt chữ, thêm hình.)
 */
import { getContent, href } from '@/lib/content.js';
import Icon from './Icon.astro';

interface Props {
  lang: string;
}

const { lang } = Astro.props;
const t = getContent(lang, 'home');

const photos = [
  '/content/vi/images/about-01.jpg',
  '/content/vi/images/about-02.jpg',
  '/content/vi/images/about-04.jpg',
];

const points = [t.value_1_title, t.value_2_title, t.value_3_title, t.value_4_title].filter(Boolean);
---

<section class="px-5 py-16 sm:py-20">
  <div class="mx-auto grid max-w-6xl items-center gap-10 lg:grid-cols-2">
    <div data-reveal>
      <p class="font-hand text-2xl text-accent-deep sm:text-3xl">{t.about_teaser_kicker}</p>
      <h2 class="mt-1 font-display text-3xl leading-tight text-ink sm:text-4xl">
        {t.about_teaser_title}
      </h2>
      <p class="mt-4 leading-relaxed text-ink-soft">{t.about_teaser_text}</p>

      {points.length > 0 && (
        <ul class="mt-5 grid gap-2 sm:grid-cols-2">
          {points.map((p) => (
            <li class="flex items-start gap-2 text-sm font-medium text-ink">
              <Icon name="check" class="mt-0.5 h-4 w-4 flex-none text-sea" />
              {p}
            </li>
          ))}
        </ul>
      )}

      <a
        href={href(lang, 'about')}
        class="mt-6 inline-flex items-center gap-2 rounded-full bg-sea px-6 py-3 text-sm font-semibold text-white transition-transform duration-200 hover:scale-[1.03] active:scale-[0.97]"
      >
        {t.about_teaser_cta}
        <Icon name="arrow-right" class="h-4 w-4" />
      </a>
    </div>

    <div class="dv-collage" data-reveal>
      {
        photos.map((p, i) => (
          <img
            src={p}
            alt={t.about_teaser_title || ''}
            loading={i === 0 ? 'eager' : 'lazy'}
            decoding="async"
          />
        ))
      }
    </div>
  </div>
</section>
