---
/**
 * Services — 4 thẻ DỊCH VỤ có ẢNH (trước đây 4 ô chỉ icon + chữ, góp phần làm
 * trang chủ bị chê "toàn chữ"). Ảnh lấy từ thư viện ảnh của site.
 */
import { getContent, href } from '@/lib/content.js';
import SectionHeading from './SectionHeading.astro';
import Icon from './Icon.astro';

interface Props {
  lang: string;
}

const { lang } = Astro.props;
const t = getContent(lang, 'home');

const photos = [
  '/content/vi/images/about-05.jpg',
  '/content/vi/images/about-03.jpg',
  '/content/vi/images/about-06.jpg',
  '/content/vi/images/about-10.jpg',
];

const services = [
  { icon: 'plane', title: t.service_ticket_title, text: t.service_ticket_text, image: photos[0], url: href(lang, 've-may-bay') },
  { icon: 'car', title: t.service_car_title, text: t.service_car_text, image: photos[1], url: href(lang, 'cho-thue-xe') },
  { icon: 'users', title: t.service_team_title, text: t.service_team_text, image: photos[2], url: href(lang, 'to-chuc-team-building') },
  { icon: 'sparkles', title: t.service_custom_title, text: t.service_custom_text, image: photos[3], url: href(lang, 'dat-tour') },
];
---

<section class="bg-sand-deep px-5 py-16 sm:py-20">
  <div class="mx-auto max-w-6xl">
    <SectionHeading kicker={t.services_kicker} title={t.services_title} text={t.services_text} />
    <div class="mt-10 grid gap-5 sm:grid-cols-2 lg:grid-cols-4">
      {
        services.map((s, i) => (
          <article class="dv-svc" data-reveal style={`--reveal-delay:${i * 0.06}s`}>
            <img src={s.image} alt={s.title} loading="lazy" decoding="async" />
            <div class="dv-svc-body">
              <span class="dv-svc-icon">
                <Icon name={s.icon} class="h-5 w-5" />
              </span>
              <h3><a href={s.url} class="hover:underline focus-visible:underline">{s.title}</a></h3>
              <p>{s.text}</p>
              <a href={s.url} class="mt-3 inline-flex min-h-11 items-center font-semibold text-sea-deep underline underline-offset-4" aria-label={`${lang === 'vi' ? 'Xem' : 'View'} ${s.title}`}>{lang === 'vi' ? 'Xem dịch vụ →' : 'View service →'}</a>
            </div>
          </article>
        ))
      }
    </div>
  </div>
</section>
