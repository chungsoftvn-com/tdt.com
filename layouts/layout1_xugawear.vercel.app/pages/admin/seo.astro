---
/**
 * /admin/seo — sửa SEO cơ bản của từng trang (title + description).
 *
 * Dữ liệu thật: `content/vi/seo.json` = { "<slug>": { title, description }, "_comment": … }
 * (key `home` áp cho cả '/' và '/vi/'; trang chi tiết tour/tin tự sinh nên không có ở đây).
 *
 * Trang này hiển thị dạng văn bản cho dễ sửa: mỗi dòng
 *     <slug> | <title> | <description>
 * rồi chuyển ngược lại JSON khi lưu (giữ nguyên các key `_comment`).
 *
 * Ô soạn thảo được ĐỔ SẴN dữ liệu SEO hiện có của website (đọc `content/vi/seo.json`
 * lúc build) — kể cả khi chưa kết nối được worker thì vẫn thấy đủ dữ liệu để sửa.
 */
import fs from 'node:fs';
import path from 'node:path';
import AdminLayout from '@/components/AdminLayout.astro';

/**
 * Đọc 1 file JSON trong repo lúc BUILD. Thử vài gốc vì lúc build cwd có thể là
 * `site/` (thường gặp) hoặc gốc repo — tránh trường hợp ô soạn thảo bị trống.
 */
function readRepoJson(rel: string) {
  const roots = [
    path.resolve(process.cwd(), '..'),
    process.cwd(),
    path.resolve(process.cwd(), '..', '..'),
  ];
  for (const root of roots) {
    try {
      const file = path.join(root, rel);
      if (fs.existsSync(file)) return JSON.parse(fs.readFileSync(file, 'utf8'));
    } catch {
      /* thử gốc kế tiếp */
    }
  }
  return {};
}
const seoSeed = readRepoJson('content/vi/seo.json');
---

<AdminLayout>
  <section>
    <h1 class="font-display text-3xl text-ink">SEO cơ bản</h1>
    <p class="mt-3 max-w-3xl text-sm leading-relaxed text-ink-soft">
      Mỗi dòng một trang, theo dạng <code class="rounded bg-sand px-1">slug | tiêu đề | mô tả</code>.
      Ví dụ: <code class="rounded bg-sand px-1">home | TodayTourist – Tour du lịch… | Công ty du lịch…</code>.
      Dòng bắt đầu bằng <code class="rounded bg-sand px-1">#</code> là ghi chú (bỏ qua).
      Slug để trống nghĩa là trang chủ. Sau khi lưu, website build lại (1–2 phút) là Google thấy nội dung mới.
    </p>

    <div class="mt-6 rounded-2xl bg-paper p-6 shadow-[var(--shadow-lift-1)]">
      <p id="seo-status" class="text-sm text-ink-soft">Đang tải…</p>
      <textarea
        id="seo-text"
        rows="22"
        class="mt-4 w-full rounded-xl border border-ink/15 bg-sand px-3 py-2.5 font-mono text-xs leading-relaxed text-ink outline-none focus:border-sea"
      ></textarea>
      <p id="seo-error" class="mt-3 hidden text-sm font-medium text-red-600"></p>
      <p id="seo-ok" class="mt-3 hidden text-sm font-medium text-sea-deep"></p>
      <div class="mt-4 flex items-center gap-3">
        <button
          id="btn-save-seo"
          type="button"
          class="rounded-full bg-sea px-6 py-2.5 text-sm font-semibold text-white transition-colors hover:bg-sea-deep"
        >
          Lưu SEO
        </button>
        <button
          id="btn-reload-seo"
          type="button"
          class="rounded-full border border-ink/15 px-5 py-2.5 text-sm font-semibold text-ink transition-colors hover:bg-ink/5"
        >
          Tải lại
        </button>
      </div>
    </div>
  </section>

  <!-- Dữ liệu SEO hiện có của website, đổ sẵn vào ô soạn thảo -->
  <script type="application/json" id="seo-seed" set:html={JSON.stringify(seoSeed)} />
</AdminLayout>

<script>
  import { api, describeSaveError } from '@/lib/admin.js';

  const textEl = document.getElementById('seo-text') as HTMLTextAreaElement | null;
  const statusEl = document.getElementById('seo-status');
  const errEl = document.getElementById('seo-error');
  const okEl = document.getElementById('seo-ok');
  const saveBtn = document.getElementById('btn-save-seo') as HTMLButtonElement | null;
  const reloadBtn = document.getElementById('btn-reload-seo') as HTMLButtonElement | null;

  let meta: Record<string, unknown> = {};

  const show = (el: HTMLElement | null, msg: string | null) => {
    if (!el) return;
    el.textContent = msg || '';
    el.classList.toggle('hidden', !msg);
  };

  function toText(data: Record<string, any>): string {
    meta = { _comment: data._comment, _comment_targets: data._comment_targets };
    return Object.entries(data)
      .filter(([k]) => !k.startsWith('_'))
      .map(([slug, v]: [string, any]) =>
        [slug, v?.title ?? '', (v?.description ?? '').replace(/\s*\|\s*/g, ' / ')].join(' | '),
      )
      .join('\n');
  }

  function toJson(text: string): Record<string, unknown> {
    const out: Record<string, unknown> = {};
    for (const [k, v] of Object.entries(meta)) if (v) out[k] = v;
    for (const raw of text.split('\n')) {
      const line = raw.trim();
      if (!line || line.startsWith('#')) continue;
      const parts = line.split('|').map((s) => s.trim());
      const slug = parts[0] || '';
      const title = parts[1] || '';
      const description = parts.slice(2).join(' | ').trim();
      if (!slug && !title && !description) continue;
      out[slug || 'home'] = { title, description };
    }
    return out;
  }

  async function load() {
    show(errEl, null);
    show(okEl, null);

    // 1) Luôn hiện dữ liệu SEO hiện có của website (nhúng lúc build) — không bao giờ trống.
    const seed = JSON.parse(document.getElementById('seo-seed')?.textContent || '{}');
    const seedN = Object.keys(seed).filter((k) => !k.startsWith('_')).length;
    if (textEl) textEl.value = toText(seed);
    if (statusEl) statusEl.textContent = `${seedN} trang (dữ liệu hiện có của website).`;

    // 2) Thử lấy bản mới nhất từ worker; nếu chưa có thì giữ bản ở bước 1.
    const r = await api('GET', '/pages/seo');
    if (r.data?.ok && r.data.page) {
      const n = Object.keys(r.data.page).filter((k) => !k.startsWith('_')).length;
      if (textEl) textEl.value = toText(r.data.page);
      if (statusEl) statusEl.textContent = `${n} trang (bản mới nhất từ máy chủ).`;
      return;
    }
    if (r.status === 401) {
      show(errEl, 'Chưa đăng nhập — đang hiện bản SEO có sẵn trong website; đăng nhập rồi tải lại để lấy bản mới nhất.');
    } else if (r.status !== 0 || !statusEl) {
      show(errEl, 'Không lấy được bản mới nhất từ máy chủ — đang hiện bản có sẵn trong website.');
    }
  }

  saveBtn?.addEventListener('click', async () => {
    show(errEl, null);
    show(okEl, null);
    const body = toJson(textEl?.value || '');
    const n = Object.keys(body).filter((k) => !k.startsWith('_')).length;
    if (!n) {
      show(errEl, 'Chưa có dòng nào hợp lệ — định dạng: slug | tiêu đề | mô tả');
      return;
    }
    saveBtn.disabled = true;
    const prev = saveBtn.textContent;
    saveBtn.textContent = 'Đang lưu…';
    const r = await api('PUT', '/pages/seo', body);
    saveBtn.textContent = prev || 'Lưu SEO';
    saveBtn.disabled = false;
    if (!r.data?.ok) {
      show(errEl, describeSaveError(r));
      return;
    }
    show(okEl, `Đã lưu ${n} trang. Website sẽ tự build lại trong 1–2 phút.`);
    load();
  });

  reloadBtn?.addEventListener('click', load);
  load();
</script>
