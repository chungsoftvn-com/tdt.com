---
// /vi/about, /vi/tours, /vi/contact ... and the same for /en.
// Page slugs come from the shared PAGE_SLUGS registry in src/lib/content.js.
import { LANGS, PAGE_SLUGS, getContent } from '@/lib/content.js';
import BaseLayout from '@/components/BaseLayout.astro';
import AboutPage from '@/components/AboutPage.astro';
import ToursPage from '@/components/ToursPage.astro';
import ContactPage from '@/components/ContactPage.astro';
import RichPage from '@/components/RichPage.astro';

export function getStaticPaths() {
  return LANGS.flatMap((lang) =>
    PAGE_SLUGS.map((page) => ({ params: { lang, page } })),
  );
}

const { lang, page } = Astro.params;
// HTML override của admin (nội dung chính) — ưu tiên hơn HTML generate bởi Astro.
// `?__sync=1` để lấy bản gốc (dùng cho nút "Đồng bộ lại nội dung").
const t = getContent(lang, page);
const isSync = Astro.url.searchParams.get('__sync') === '1';
const override =
  !isSync && t && typeof t.html_override === 'string' && t.html_override.trim()
    ? t.html_override
    : '';
---

{override ? (
  <BaseLayout lang={lang}>
    <div class="html-override" set:html={override} />
  </BaseLayout>
) : (
  <>
    {page === 'about' && <AboutPage lang={lang} />}
    {page === 'tours' && <ToursPage lang={lang} />}
    {page === 'contact' && <ContactPage lang={lang} />}
    {page === 've-may-bay' && <RichPage lang={lang} page="ve-may-bay" />}
    {page === 'cho-thue-xe' && <RichPage lang={lang} page="cho-thue-xe" />}
  </>
)}
