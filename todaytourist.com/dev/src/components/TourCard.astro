---
import { getContent, href } from '@/lib/content.js';
import Icon from './Icon.astro';

interface Props {
  lang: string;
  tour: {
    slug: string;
    name: string;
    region: string;
    regionName: string;
    duration: string;
    price: string;
    image: string;
    desc: string;
    highlights: string[];
  };
}

const { lang, tour } = Astro.props;
const t = getContent(lang, 'common');
const url = href(lang, `tour/${tour.slug}`);
---

<article
  data-reveal
  class="group flex flex-col overflow-hidden rounded-2xl bg-paper shadow-[var(--shadow-lift-1)] transition-[transform,box-shadow] duration-300 ease-[var(--ease-soft)] hover:-translate-y-1.5 hover:shadow-[var(--shadow-lift-2)]"
>
  <a href={url} class="relative block aspect-[16/10] overflow-hidden" tabindex="-1" aria-hidden="true">
    <img
      src={`/content/vi/images/${tour.image}`}
      alt={tour.name}
      loading="lazy"
      decoding="async"
      width="900"
      height="506"
      class="h-full w-full object-cover transition-transform duration-500 ease-[var(--ease-soft)] group-hover:scale-[1.06]"
    />
    <span class="absolute left-3 top-3 rounded-full bg-sand/90 px-3 py-1 text-xs font-semibold text-ink backdrop-blur-sm">
      {tour.regionName}
    </span>
  </a>

  <div class="flex flex-1 flex-col p-5">
    <h3 class="font-display text-xl leading-snug text-ink">
      <a href={url} class="hover:text-sea-deep">{tour.name}</a>
    </h3>
    <p class="mt-2 line-clamp-2 text-sm leading-relaxed text-ink-soft">{tour.desc}</p>

    <div class="mt-4 flex items-center justify-between border-t border-ink/10 pt-4">
      <div>
        <p class="text-xs text-ink-soft">{t.duration}</p>
        <p class="mt-0.5 flex items-center gap-1 text-sm font-medium text-ink">
          <Icon name="calendar" class="h-4 w-4 text-sea" />
          {tour.duration}
        </p>
      </div>
      <div class="text-right">
        <p class="text-xs text-ink-soft">{t.price}</p>
        <p class="mt-0.5 text-base font-bold text-accent-deep">{tour.price}</p>
      </div>
    </div>

    <a
      href={url}
      class="mt-4 inline-flex items-center justify-center gap-1.5 rounded-full border border-ink/15 px-4 py-2 text-sm font-semibold text-ink transition-colors hover:border-sea hover:bg-sea hover:text-white"
    >
      {t.cta_details}
      <Icon name="arrow-right" class="h-4 w-4" />
    </a>
  </div>
</article>
