---
import { getContent, href, langHref } from '@/lib/content.js';
import Icon from './Icon.astro';

interface Props {
  lang: string;
}

const { lang } = Astro.props;
const t = getContent(lang, 'common');
const alt = lang === 'vi' ? 'en' : 'vi';
const current = Astro.url.pathname;

const nav = [
  { key: 'nav_home', url: href(lang) },
  { key: 'nav_about', url: href(lang, 'about') },
  { key: 'nav_tours', url: href(lang, 'tours') },
  { key: 'nav_news', url: href(lang, 'tin-tuc') },
  { key: 'nav_contact', url: href(lang, 'contact') },
];

const isActive = (url: string) => {
  if (url === href(lang)) {
    return (
      current === '/' ||
      current === url ||
      current === `${url}/` ||
      current === '/vi' ||
      current === '/en'
    );
  }
  return current === url || current.startsWith(`${url}/`);
};

const viLink = langHref('vi', current);
const enLink = langHref('en', current);
---

<header class="sticky top-0 z-50 border-b border-ink/10 bg-sand/85 backdrop-blur-md">
  <div class="mx-auto flex max-w-6xl items-center justify-between gap-3 px-5 py-3">
    <!-- Brand -->
    <a href={href(lang)} class="group flex shrink-0 items-center gap-2.5" aria-label={t.brand_name}>
      <img
        src="/content/vi/images/logo.webp"
        alt={t.brand_name}
        width="74"
        height="80"
        loading="lazy"
        decoding="async"
        class="h-11 w-auto transition-transform duration-300 group-hover:scale-105"
      />
      <span class="leading-none">
        <span class="block font-display text-lg font-semibold tracking-wide text-ink">
          {t.brand_name}
        </span>
        <span class="block text-[0.62rem] font-semibold uppercase tracking-[0.22em] text-ink-soft">
          {t.brand_tagline}
        </span>
      </span>
    </a>

    <!-- Desktop nav -->
    <nav aria-label="Primary" class="hidden lg:block">
      <ul class="flex items-center gap-1">
        {
          nav.map((item) => (
            <li>
              <a
                href={item.url}
                aria-current={isActive(item.url) ? 'page' : undefined}
                class="relative rounded-full px-3.5 py-2 text-sm font-medium text-ink-soft transition-colors duration-200 hover:text-ink aria-[current=page]:text-ink"
              >
                {t[item.key]}
                {
                  isActive(item.url) && (
                    <span class="absolute inset-x-3 -bottom-0.5 h-0.5 rounded-full bg-accent" />
                  )
                }
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <div class="flex items-center gap-2">
      <!-- Language switcher (keeps you on the same page) -->
      <div class="flex items-center rounded-full border border-ink/10 bg-paper p-1 text-xs font-bold">
        <a
          href={viLink}
          lang="vi"
          title={t.lang_vi}
          class={
            lang === 'vi'
              ? 'rounded-full bg-sea px-2.5 py-1 text-white'
              : 'rounded-full px-2.5 py-1 text-ink-soft transition-colors hover:text-ink'
          }
        >
          {t.lang_code_vi}
        </a>
        <a
          href={enLink}
          lang="en"
          title={t.lang_en}
          class={
            lang === 'en'
              ? 'rounded-full bg-sea px-2.5 py-1 text-white'
              : 'rounded-full px-2.5 py-1 text-ink-soft transition-colors hover:text-ink'
          }
        >
          {t.lang_code_en}
        </a>
      </div>

      <a
        href={`tel:${t.hotline.replace(/[^0-9]/g, '')}`}
        class="hidden items-center gap-2 rounded-full bg-accent px-4 py-2 text-sm font-semibold text-white shadow-[3px_3px_0_rgba(194,65,12,.25)] transition-transform duration-200 hover:scale-[1.03] active:scale-[0.97] md:inline-flex"
      >
        <Icon name="phone" class="h-4 w-4" />
        {t.hotline}
      </a>

      <!-- Mobile menu button -->
      <button
        type="button"
        data-mobile-toggle
        aria-label={t.nav_home}
        aria-expanded="false"
        class="inline-flex h-10 w-10 items-center justify-center rounded-full border border-ink/10 bg-paper text-ink lg:hidden"
      >
        <span data-menu-icon-open><Icon name="menu" class="h-5 w-5" /></span>
        <span data-menu-icon-close class="hidden"><Icon name="close" class="h-5 w-5" /></span>
      </button>
    </div>
  </div>

  <!-- Mobile menu -->
  <div data-mobile-menu class="hidden border-t border-ink/10 bg-sand px-5 pb-5 lg:hidden">
    <nav aria-label="Mobile" class="py-3">
      <ul class="space-y-1">
        {
          nav.map((item) => (
            <li>
              <a
                href={item.url}
                class={`block rounded-xl px-4 py-2.5 text-base font-medium ${
                  isActive(item.url) ? 'bg-sea-pale text-sea-deep' : 'text-ink-soft'
                }`}
              >
                {t[item.key]}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
    <a
      href={`tel:${t.hotline.replace(/[^0-9]/g, '')}`}
      class="inline-flex w-full items-center justify-center gap-2 rounded-full bg-accent px-4 py-2.5 text-sm font-semibold text-white"
    >
      <Icon name="phone" class="h-4 w-4" />
      {t.cta_call} · {t.hotline}
    </a>
  </div>
</header>

<script>
  const toggle = document.querySelector('[data-mobile-toggle]');
  const menu = document.querySelector('[data-mobile-menu]');
  const iconOpen = document.querySelector('[data-menu-icon-open]');
  const iconClose = document.querySelector('[data-menu-icon-close]');
  toggle?.addEventListener('click', () => {
    const hidden = menu?.classList.toggle('hidden');
    iconOpen?.classList.toggle('hidden', !hidden);
    iconClose?.classList.toggle('hidden', hidden);
    toggle.setAttribute('aria-expanded', String(!hidden));
  });
  // Close the menu when a link inside it is tapped.
  menu?.querySelectorAll('a').forEach((a) =>
    a.addEventListener('click', () => {
      menu.classList.add('hidden');
      iconOpen?.classList.remove('hidden');
      iconClose?.classList.add('hidden');
    }),
  );
</script>
