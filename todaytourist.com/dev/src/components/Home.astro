---
/**
 * Home — trang chủ được dựng từ danh sách khối (block) trong `home_blocks`.
 * Mỗi khối chuẩn render bằng component đẹp có sẵn (Hero, AboutTeaser, Services,
 * Stats, Values, CTABand) + mục "Tour hot"; khối "custom" render nội dung
 * SunEditor admin soạn. Admin bật/tắt, xoá, thêm, sắp xếp khối ở /admin/pages.
 */
import { getContent, getTours, href } from '@/lib/content.js';
import { richDoc } from '@/lib/rich.js';
import { DEFAULT_HOME_BLOCKS, customBodyKey } from '@/lib/homeblocks.js';
import BaseLayout from './BaseLayout.astro';
import Hero from './Hero.astro';
import AboutTeaser from './AboutTeaser.astro';
import Services from './Services.astro';
import Stats from './Stats.astro';
import Values from './Values.astro';
import CTABand from './CTABand.astro';
import ToursGrid from './ToursGrid.astro';
import SectionHeading from './SectionHeading.astro';
import Icon from './Icon.astro';

interface Props {
  lang: string;
}

const { lang } = Astro.props;
const t = getContent(lang, 'home');
const tours = getTours(lang);
const hotSlugs = Array.isArray(t.hot_tours) ? t.hot_tours : [];
const hotTours = hotSlugs.length ? tours.filter((x) => hotSlugs.includes(x.slug)) : tours.slice(0, 6);
const read = (k) => (typeof t[k] === 'string' ? t[k] : '');
const blocks = (Array.isArray(t.home_blocks) && t.home_blocks.length
  ? t.home_blocks
  : DEFAULT_HOME_BLOCKS
).filter((b) => b && b.type && b.enabled !== false);
---

<BaseLayout lang={lang}>
  {
    blocks.map((b) => {
      switch (b.type) {
        case 'hero':
          return <Hero lang={lang} />;
        case 'about':
          return <AboutTeaser lang={lang} />;
        case 'services':
          return <Services lang={lang} />;
        case 'stats':
          return <Stats lang={lang} />;
        case 'hot':
          return (
            <section class="bg-sand-deep px-5 py-16 sm:py-20">
              <div class="mx-auto max-w-6xl">
                <SectionHeading
                  kicker={t.hot_tours_kicker}
                  title={t.hot_tours_title}
                  text={t.hot_tours_text}
                />
                <div class="mt-10">
                  <ToursGrid lang={lang} tours={hotTours} />
                </div>
                <div class="mt-10 text-center">
                  <a
                    href={href(lang, 'tours')}
                    class="inline-flex items-center gap-2 rounded-full px-5 py-3 text-sm font-semibold text-sea-deep transition-colors hover:bg-sea-pale"
                  >
                    {t.view_all_tours}
                    <Icon name="arrow-right" class="h-4 w-4" />
                  </a>
                </div>
              </div>
            </section>
          );
        case 'values':
          return <Values lang={lang} />;
        case 'cta':
          return <CTABand lang={lang} />;
        case 'custom':
          return (
            <section class="px-5 py-16 sm:py-20">
              <div class="rich-doc mx-auto max-w-4xl" set:html={richDoc(read(customBodyKey(b.id)))} />
            </section>
          );
        default:
          return null;
      }
    })
  }
</BaseLayout>

<style>
  .rich-doc {
    color: var(--color-ink-soft);
  }
  .rich-doc h1 {
    font-family: var(--font-display);
    font-size: 2.4rem;
    line-height: 1.2;
    color: var(--color-ink);
    margin: 0 0 0.75rem;
  }
  .rich-doc h2 {
    font-family: var(--font-display);
    font-size: 1.6rem;
    line-height: 1.3;
    color: var(--color-ink);
    margin: 1.75rem 0 0.75rem;
  }
  .rich-doc h3 {
    font-family: var(--font-display);
    font-size: 1.2rem;
    line-height: 1.35;
    color: var(--color-ink);
    margin: 1.25rem 0 0.6rem;
  }
  .rich-doc p {
    margin: 0.75rem 0;
    line-height: 1.85;
  }
  .rich-doc ul,
  .rich-doc ol {
    margin: 0.75rem 0;
    padding-left: 1.5rem;
  }
  .rich-doc ul {
    list-style: disc;
  }
  .rich-doc ol {
    list-style: decimal;
  }
  .rich-doc li {
    margin: 0.3rem 0;
    line-height: 1.7;
  }
  .rich-doc a {
    color: var(--color-sea);
    text-decoration: underline;
    text-underline-offset: 2px;
  }
  .rich-doc img {
    margin: 1rem 0;
    border-radius: 1rem;
    height: auto;
    max-width: 100%;
  }
  .rich-doc blockquote {
    margin: 1rem 0;
    border-left: 3px solid var(--color-sea);
    padding: 0.25rem 0 0.25rem 1rem;
    font-style: italic;
  }
  .rich-doc table {
    width: 100%;
    border-collapse: collapse;
    margin: 1rem 0;
  }
  .rich-doc th,
  .rich-doc td {
    border: 1px solid var(--color-ink-soft);
    padding: 0.5rem 0.75rem;
  }
  .rich-doc th {
    background: var(--color-sand-deep);
    font-weight: 600;
    color: var(--color-ink);
  }
  .rich-doc hr {
    margin: 1.5rem 0;
    border: 0;
    border-top: 1px solid var(--color-ink-soft);
  }
</style>
