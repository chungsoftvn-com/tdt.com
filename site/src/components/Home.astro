---
/**
 * Home — trang chủ được dựng từ danh sách khối (block) trong `home_blocks`.
 * Mỗi khối chuẩn render bằng component đẹp có sẵn (Hero, AboutTeaser, Services,
 * Stats, Values, CTABand) + mục "Tour hot"; khối "custom" render nội dung
 * SunEditor admin soạn. Admin bật/tắt, xoá, thêm, sắp xếp khối ở /admin/pages.
 */
import { getContent, getTours, href } from '@/lib/content.js';
import { richDoc } from '@/lib/rich.js';
import { DEFAULT_HOME_BLOCKS, customBodyKey } from '@/lib/homeblocks.js';
import BaseLayout from './BaseLayout.astro';
import Hero from './Hero.astro';
import AboutTeaser from './AboutTeaser.astro';
import Services from './Services.astro';
import Stats from './Stats.astro';
import Values from './Values.astro';
import CTABand from './CTABand.astro';
import PartnersSlider from './PartnersSlider.astro';
import ToursGrid from './ToursGrid.astro';
import SectionHeading from './SectionHeading.astro';
import Icon from './Icon.astro';

interface Props {
  lang: string;
}

const { lang } = Astro.props;
const t = getContent(lang, 'home');
const c = getContent(lang, 'common');
const tours = getTours(lang);
const hotSlugs = Array.isArray(t.hot_tours) ? t.hot_tours : [];
const hotTours = hotSlugs.length ? tours.filter((x) => hotSlugs.includes(x.slug)) : tours.slice(0, 6);

/** 4 tour đầu = mosaic "Điểm đến nổi bật"; lưới "Tour hot" lấy các tour KHÁC (tránh lặp ảnh). */
const featuredTours = (hotTours.length ? hotTours : tours).slice(0, 4);
const featuredSlugs = new Set(featuredTours.map((x) => x.slug));
const gridTours = tours.filter((x) => !featuredSlugs.has(x.slug)).slice(0, 8);

/** Dải ảnh "Khoảnh khắc hành trình" — ảnh thư viện + ảnh tour. */
const photoStrip = [
  'about-07.jpg',
  'about-09.jpg',
  'about-11.jpg',
  'about-12.jpg',
  'about-13.jpg',
  'about-14.jpg',
  ...tours.filter((x) => x && x.image).slice(0, 2).map((x) => x.image),
].slice(0, 8);
const read = (k) => (typeof t[k] === 'string' ? t[k] : '');
const blocks = (Array.isArray(t.home_blocks) && t.home_blocks.length
  ? t.home_blocks
  : DEFAULT_HOME_BLOCKS
).filter((b) => b && b.type && b.enabled !== false);
---

<BaseLayout lang={lang}>
  {
    blocks.map((b) => {
      switch (b.type) {
        case 'hero':
          return (
            <>
              <Hero lang={lang} />
              {/* Mosaic "Điểm đến nổi bật" — khối ảnh lớn ngay đầu trang */}
              {featuredTours.length > 0 && (
                <section class="bg-sand px-5 py-10">
                  <div class="mx-auto max-w-6xl">
                    <div class="dv-head">
                      <h2>{lang === 'vi' ? 'Điểm đến nổi bật' : 'Featured destinations'}</h2>
                      <a href={href(lang, 'tours')}>{t.view_all_tours}</a>
                    </div>
                    <div class="dv-mosaic">
                      {featuredTours.map((tour, i) => (
                        <a
                          class={`dv-mosaic-item ${i === 0 ? 'dv-mosaic-big' : ''}`}
                          href={href(lang, `tours/${tour.slug}`)}
                        >
                          <img
                            src={`/content/vi/images/${tour.image}`}
                            alt={tour.name}
                            loading={i === 0 ? 'eager' : 'lazy'}
                            decoding="async"
                          />
                          <span class="dv-mosaic-cap">
                            <strong>{tour.name}</strong>
                            {tour.duration && <em>{tour.duration}</em>}
                          </span>
                        </a>
                      ))}
                    </div>
                  </div>
                </section>
              )}
            </>
          );
        case 'about':
          return <AboutTeaser lang={lang} />;
        case 'services':
          return <Services lang={lang} />;
        case 'stats':
          return <Stats lang={lang} />;
        case 'hot':
          return (
            <section class="bg-sand-deep px-5 py-16 sm:py-20">
              <div class="mx-auto max-w-6xl">
                <SectionHeading
                  kicker={t.hot_tours_kicker}
                  title={t.hot_tours_title}
                  text={t.hot_tours_text}
                />
                <div class="mt-10">
                  <ToursGrid lang={lang} tours={gridTours} />
                </div>
                <div class="mt-10 text-center">
                  <a
                    href={href(lang, 'tours')}
                    class="inline-flex items-center gap-2 rounded-full px-5 py-3 text-sm font-semibold text-sea-deep transition-colors hover:bg-sea-pale"
                  >
                    {t.view_all_tours}
                    <Icon name="arrow-right" class="h-4 w-4" />
                  </a>
                </div>
              </div>
            </section>
          );
        case 'values':
          return <Values lang={lang} />;
        case 'partners':
          return <PartnersSlider lang={lang} />;
        case 'cta':
          return <CTABand lang={lang} />;
        case 'custom':
          return (
            <section class="px-5 py-16 sm:py-20">
              <div class="rich-doc mx-auto max-w-4xl" set:html={richDoc(read(customBodyKey(b.id)))} />
            </section>
          );
        default:
          return null;
      }
    })
  }

  {/* Dải ảnh "Khoảnh khắc hành trình" — thêm hình, bớt chữ */}
  {
    photoStrip.length >= 4 && (
      <section class="border-t border-ink/5 bg-sand px-5 py-14">
        <div class="mx-auto max-w-6xl">
          <div class="dv-head">
            <h2>{lang === 'vi' ? 'Khoảnh khắc hành trình' : 'Trip moments'}</h2>
            <a href={href(lang, 'tours')}>{t.view_all_tours}</a>
          </div>
          <div class="dv-strip">
            {photoStrip.map((p) => (
              <a class="dv-strip-item" href={href(lang, 'tours')}>
                <img src={`/content/vi/images/${p}`} alt="" loading="lazy" decoding="async" />
              </a>
            ))}
          </div>
        </div>
      </section>
    )
  }

  <!-- Tư vấn & Kinh doanh (như web cũ) -->
  {
    c.sales_title && (
      <section class="border-t border-ink/5 bg-sand px-5 py-12">
        <div class="mx-auto max-w-6xl text-center">
          <h2 class="font-display text-2xl text-ink">{c.sales_title}</h2>
          <div class="rich-doc mx-auto mt-4 max-w-2xl" set:html={richDoc(c.sales_body_html)} />
        </div>
      </section>
    )
  }
</BaseLayout>

<style>
  .rich-doc {
    color: var(--color-ink-soft);
  }
  .rich-doc h1 {
    font-family: var(--font-display);
    font-size: 2.4rem;
    line-height: 1.2;
    color: var(--color-ink);
    margin: 0 0 0.75rem;
  }
  .rich-doc h2 {
    font-family: var(--font-display);
    font-size: 1.6rem;
    line-height: 1.3;
    color: var(--color-ink);
    margin: 1.75rem 0 0.75rem;
  }
  .rich-doc h3 {
    font-family: var(--font-display);
    font-size: 1.2rem;
    line-height: 1.35;
    color: var(--color-ink);
    margin: 1.25rem 0 0.6rem;
  }
  .rich-doc p {
    margin: 0.75rem 0;
    line-height: 1.85;
  }
  .rich-doc ul,
  .rich-doc ol {
    margin: 0.75rem 0;
    padding-left: 1.5rem;
  }
  .rich-doc ul {
    list-style: disc;
  }
  .rich-doc ol {
    list-style: decimal;
  }
  .rich-doc li {
    margin: 0.3rem 0;
    line-height: 1.7;
  }
  .rich-doc a {
    color: var(--color-sea);
    text-decoration: underline;
    text-underline-offset: 2px;
  }
  .rich-doc img {
    margin: 1rem 0;
    border-radius: 1rem;
    height: auto;
    max-width: 100%;
  }
  .rich-doc blockquote {
    margin: 1rem 0;
    border-left: 3px solid var(--color-sea);
    padding: 0.25rem 0 0.25rem 1rem;
    font-style: italic;
  }
  .rich-doc table {
    width: 100%;
    border-collapse: collapse;
    margin: 1rem 0;
  }
  .rich-doc th,
  .rich-doc td {
    border: 1px solid var(--color-ink-soft);
    padding: 0.5rem 0.75rem;
  }
  .rich-doc th {
    background: var(--color-sand-deep);
    font-weight: 600;
    color: var(--color-ink);
  }
  .rich-doc hr {
    margin: 1.5rem 0;
    border: 0;
    border-top: 1px solid var(--color-ink-soft);
  }
</style>
