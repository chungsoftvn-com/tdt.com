---
/**
 * Hero — ẢNH THẬT làm nền (trước đây nền phẳng + chữ nên trang chủ bị chê
 * "toàn chữ"). Ảnh lấy từ tour nổi bật đầu tiên; không có thì dùng ảnh thư viện.
 */
import { getContent, getTours, href } from '@/lib/content.js';
import Icon from './Icon.astro';

interface Props {
  lang: string;
}

const { lang } = Astro.props;
const t = getContent(lang, 'home');
const c = getContent(lang, 'common');

const tours = getTours(lang);
const firstWithImage = tours.find((x) => x && x.image);
const heroImage = firstWithImage
  ? `/content/vi/images/${firstWithImage.image}`
  : '/content/vi/images/about-11.jpg';
---

<section class="relative isolate overflow-hidden bg-sea-deep">
  <img
    src={heroImage}
    alt=""
    class="absolute inset-0 -z-10 h-full w-full object-cover"
    loading="eager"
    decoding="async"
  />
  <div class="absolute inset-0 -z-10 bg-gradient-to-r from-sea-deep/95 via-sea-deep/75 to-sea-deep/30">
  </div>

  <div class="relative mx-auto max-w-6xl px-5 py-20 text-center text-white sm:py-28">
    <p
      data-reveal
      class="inline-flex items-center gap-2 font-hand text-2xl text-white/95 sm:text-3xl [text-shadow:0_1px_14px_rgba(0,0,0,.35)]"
    >
      <Icon name="sparkles" class="h-6 w-6" />
      {t.hero_kicker}
    </p>
    <h1
      data-reveal
      style="--reveal-delay:0.06s"
      class="mx-auto mt-3 max-w-3xl font-display text-4xl leading-[1.08] [text-shadow:0_2px_18px_rgba(0,0,0,.4)] sm:text-6xl"
    >
      {t.hero_title}
    </h1>
    <p
      data-reveal
      style="--reveal-delay:0.12s"
      class="mx-auto mt-5 max-w-2xl text-lg leading-relaxed text-white/90"
    >
      {t.hero_text}
    </p>
    <div
      data-reveal
      style="--reveal-delay:0.18s"
      class="mt-9 flex flex-wrap items-center justify-center gap-3"
    >
      <a
        href={href(lang, 'tours')}
        class="inline-flex min-h-12 items-center gap-2 rounded-full bg-accent px-7 py-3 text-sm font-semibold text-white shadow-[3px_3px_0_rgba(0,0,0,.25)] transition-transform duration-200 hover:scale-[1.03] active:scale-[0.97]"
      >
        {t.hero_cta_primary}
        <Icon name="arrow-right" class="h-4 w-4" />
      </a>
      <a
        href={`tel:${c.hotline.replace(/[^0-9]/g, '')}`}
        class="inline-flex min-h-12 items-center gap-2 rounded-full border border-white/70 px-7 py-3 text-sm font-semibold text-white backdrop-blur-sm transition-colors hover:bg-white/15"
      >
        <Icon name="phone" class="h-4 w-4" />
        {t.hero_cta_secondary}
      </a>
    </div>
  </div>

  <span class="wave-edge text-sand" aria-hidden="true">
    <svg viewBox="0 0 1200 40" preserveAspectRatio="none">
      <path d="M0 0H1200V20Q1100 0 1000 20T800 20T600 20T400 20T200 20T0 20Z" fill="currentColor" />
    </svg>
  </span>
</section>
