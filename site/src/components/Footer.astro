---
/**
 * Footer — 4 cột, mỗi cột là 1 khối nội dung do admin soạn bằng SunEditor riêng
 * (body_html / footer_quick_body / footer_contact_body / footer_social_body).
 * Bản EN: link /vi/... được đổi sang /en/...
 */
import { getContent } from '@/lib/content.js';
import { richDoc } from '@/lib/rich.js';
import { bodyFor } from '@/lib/pagebody.js';

interface Props {
  lang: string;
}

const { lang } = Astro.props;
const t = getContent(lang, 'common');
const keys = ['body_html', 'footer_quick_body', 'footer_contact_body', 'footer_social_body'];
const cols = keys.map((k) => {
  let h = bodyFor('common', t, k);
  if (lang !== 'vi') {
    h = h.replace(/href="\/vi\//g, 'href="/en/').replace(/href="\/vi"/g, 'href="/en"');
  }
  return h;
});
---

<footer class="bg-ink text-sand">
  <div class="mx-auto grid max-w-6xl gap-10 px-5 py-14 sm:grid-cols-2 lg:grid-cols-4">
    {
      cols.map((h) => (
        <div>
          <div class="rich-footer text-sm leading-relaxed text-sand/70" set:html={richDoc(h)} />
        </div>
      ))
    }
  </div>

  <div class="border-t border-sand/15 px-5 py-6 text-center">
    <p class="mx-auto max-w-2xl text-sm leading-relaxed text-accent-pale">{t.footer_offer}</p>
    <p class="mt-1.5 text-xs text-sand/60">{t.footer_credit}</p>
  </div>
  <div class="border-t border-sand/15 px-5 py-4 text-center text-xs text-sand/60">
    {t.copyright} · {t.rights}
  </div>
</footer>

<style>
  .rich-footer h3 {
    color: #ffffff;
    margin: 0 0 0.75rem;
    font-size: 1.05rem;
    font-weight: 700;
  }
  .rich-footer p {
    margin: 0.4rem 0;
    line-height: 1.7;
  }
  .rich-footer img {
    max-width: 100%;
    height: auto;
    border-radius: 0.75rem;
    margin: 0.75rem 0;
  }
  .rich-footer a {
    text-decoration: underline;
    text-underline-offset: 2px;
  }
</style>
